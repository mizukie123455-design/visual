local MOVABLE = {
	"Attachment", "ParticleEmitter", "Light", "Beam", "Trail", "Fire",
	"Smoke", "Sparkles", "Highlight", "Decal", "Texture", "SpecialMesh",
}

function F.movable(i)
	for _, c in ipairs(MOVABLE) do
		if i:IsA(c) then
			return true
		end
	end
	return false
end

function F.isJoint(i)
	return i:IsA("JointInstance") or i:IsA("WeldConstraint")
end

function F.isOur(p)
	local cur = p
	while cur do
		if ourSet[cur] then
			return true
		end
		cur = cur.Parent
	end
	return false
end

function F.rigPartFor(rig, name)
	local list = BODY[name] or { name }
	for _, n in ipairs(list) do
		local p = rig:FindFirstChild(n)
		if not (p and p:IsA("BasePart") and not F.isOur(p)) then
			p = nil
			for _, d in ipairs(rig:GetDescendants()) do
				if d.Name == n and d:IsA("BasePart") and not F.isOur(d) then
					p = d
					break
				end
			end
		end
		if p then
			return p
		end
	end
	return nil
end

function F.fixPart(p)
	p.Anchored = false
	p.CanCollide = false
	p.Massless = true
	p.CanQuery = false
	p.CanTouch = false
end

function F.primaryOf(top)
	if top:IsA("BasePart") then
		return top
	end
	if top:IsA("Model") and top.PrimaryPart then
		return top.PrimaryPart
	end
	return top:FindFirstChildWhichIsA("BasePart", true)
end

function F.destroyHandle(h)
	if not h then
		return
	end
	for _, i in ipairs(h.items) do
		ourSet[i] = nil
		pcall(function()
			i:Destroy()
		end)
	end
	ourSet[h.container] = nil
	pcall(function()
		h.container:Destroy()
	end)
end

-- Главная функция. Берёт шаблон (Character / CharacterClassic), заменяет части-пустышки
-- на настоящие части рига и вешает всё остальное (реквизит, аксессуары, частицы) на риг.
-- opts: name, parent, pick (имя модели внутри шаблона), skin (персонаж целиком),
--       animated (Motor6D для анимации), fbCF (запасное крепление к торсу)
function F.graft(root, rig, opts)
	opts = opts or {}
	local hum = rig:FindFirstChildOfClass("Humanoid")
	local JC = opts.animated and "Motor6D" or "Weld"
	local cl = root:Clone()
	for _, d in ipairs(cl:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			pcall(function()
				d:Destroy()
			end)
		end
	end
	if opts.pick then
		local em = cl:FindFirstChild(opts.pick, true)
		if not em then
			cl:Destroy()
			return nil
		end
		local holder = Instance.new("Model")
		em.Parent = holder
		cl:Destroy()
		cl = holder
	end

	local container = Instance.new("Folder")
	container.Name = opts.name or "LocalVisualProp"
	container.Parent = opts.parent or getFolder()
	ourSet[container] = true
	local h = { container = container, items = {}, exact = 0, parts = 0, notes = {}, firstJoint = nil, rigJoints = {} }
	local function track(i)
		table.insert(h.items, i)
		ourSet[i] = true
	end
	local function note(s)
		if #h.notes < 12 then
			table.insert(h.notes, s)
		end
	end
	local function recordRigJoint(j, rigIsP0)
		table.insert(h.rigJoints, { j = j, rigIsP0 = rigIsP0, c0 = j.C0, c1 = j.C1 })
		if not h.firstJoint then
			h.firstJoint = j
		end
		h.exact = h.exact + 1
	end

	-- части-пустышки (тело в шаблоне)
	local dummy, dummyCF = {}, {}
	if not opts.skin then
		for _, t in ipairs(cl:GetChildren()) do
			if BODY[t.Name] and (t:IsA("BasePart") or t:IsA("Model") or t:IsA("Folder")) then
				if not (t:IsA("Model") and t:FindFirstChildOfClass("Humanoid")) then
					dummy[t] = true
					if t:IsA("BasePart") then
						dummyCF[t.Name] = t.CFrame
					end
				end
			end
		end
	end
	local function topOf(x)
		local cur = x
		while cur and cur.Parent ~= cl do
			cur = cur.Parent
		end
		return cur
	end
	local function dummyTopOf(x)
		local t = topOf(x)
		if t and dummy[t] then
			return t
		end
		return nil
	end
	local function kindOf(p)
		if not p then
			return "nil"
		end
		if p == cl or p:IsDescendantOf(cl) then
			if dummyTopOf(p) then
				return "dummy"
			end
			return "prop"
		end
		return "outside"
	end
	local function addAcc(acc)
		acc.Parent = nil
		local ok = false
		if hum then
			ok = pcall(function()
				hum:AddAccessory(acc)
			end)
		end
		if ok then
			track(acc)
			h.exact = h.exact + 1
		else
			acc.Parent = container
		end
	end

	-- 1. связки между реквизитом и телом -> перевешиваем на настоящие части рига
	local connected, links = {}, {}
	local function markConn(p)
		local t = p and topOf(p)
		if t then
			connected[t] = true
		end
	end
	local joints = {}
	for _, d in ipairs(cl:GetDescendants()) do
		if F.isJoint(d) then
			table.insert(joints, d)
		end
	end
	for _, d in ipairs(joints) do
		local p0, p1 = d.Part0, d.Part1
		local k0, k1 = kindOf(p0), kindOf(p1)
		local pr0, pr1 = (k0 == "prop"), (k1 == "prop")
		if pr0 ~= pr1 then
			local other = pr0 and p1 or p0
			local okind = pr0 and k1 or k0
			local propPart = pr0 and p0 or p1
			local nm
			if other then
				local dt = (okind == "dummy") and dummyTopOf(other) or nil
				nm = (BODY[other.Name] and other.Name) or (dt and dt.Name) or other.Name
			else
				nm = BODY[d.Name] and d.Name or "Torso"
			end
			local rp = F.rigPartFor(rig, nm)
			if not rp then
				rp = findTorso(rig)
				note("нет части '" .. nm .. "' у рига, взят торс")
			end
			if rp then
				local nj = d
				if d:IsA("WeldConstraint") then
					nj = Instance.new(JC)
					nj.Name = "LocalVisualJoint"
					local rel = CFrame.new()
					if p0 and p1 then
						rel = p0.CFrame:ToObjectSpace(p1.CFrame)
					end
					nj.C0 = rel
					nj.C1 = CFrame.new()
				end
				if pr0 then
					nj.Part0 = propPart
					nj.Part1 = rp
				else
					nj.Part0 = rp
					nj.Part1 = propPart
				end
				nj.Parent = rp
				if nj ~= d then
					d:Destroy()
				end
				track(nj)
				recordRigJoint(nj, not pr0)
				markConn(propPart)
				note(nj.Name .. ": " .. rp.Name .. " <-> " .. propPart.Name .. " (шаблон: " .. nm .. ")")
			else
				d:Destroy()
			end
		elseif pr0 and pr1 then
			table.insert(links, { topOf(p0), topOf(p1) })
		else
			d:Destroy()
		end
	end

	-- 1b. скин персонажа: части тела шаблона приваривается к частям рига
	if opts.skin then
		local bodyParts, isBody = {}, {}
		for _, p in ipairs(cl:GetDescendants()) do
			if p:IsA("BasePart") and BODY[p.Name] and not p:FindFirstAncestorOfClass("Accessory") then
				table.insert(bodyParts, p)
				isBody[p] = true
			end
		end
		for _, d in ipairs(cl:GetDescendants()) do
			if F.isJoint(d) and d.Part0 and d.Part1 and isBody[d.Part0] and isBody[d.Part1] then
				d:Destroy()
			end
		end
		for _, p in ipairs(bodyParts) do
			local rp = F.rigPartFor(rig, p.Name)
			if rp then
				local j = Instance.new("Weld")
				j.Name = "LocalSkinJoint"
				j.Part0 = rp
				j.Part1 = p
				j.C0 = CFrame.new()
				j.C1 = CFrame.new()
				j.Parent = rp
				track(j)
				h.exact = h.exact + 1
				markConn(p)
			else
				p:Destroy()
			end
		end
	end

	-- связанные между собой части считаем подключёнными
	local changed = true
	while changed do
		changed = false
		for _, l in ipairs(links) do
			if l[1] and l[2] and ((connected[l[1]] or false) ~= (connected[l[2]] or false)) then
				connected[l[1]] = true
				connected[l[2]] = true
				changed = true
			end
		end
	end

	-- 2. содержимое пустышек (частицы, аттачменты, декали) -> на настоящие части
	for top in pairs(dummy) do
		local rp = F.rigPartFor(rig, top.Name)
		for _, ch in ipairs(top:GetChildren()) do
			if F.isJoint(ch) then
				-- уже обработано
			elseif ch:IsA("Accessory") then
				addAcc(ch)
			elseif ch:IsA("BasePart") or ch:IsA("Model") then
				ch.Parent = container
			elseif F.movable(ch) and rp then
				ch.Parent = rp
				track(ch)
			end
		end
	end

	-- 3. остальное из шаблона
	for _, ch in ipairs(cl:GetChildren()) do
		if dummy[ch] then
			ch:Destroy()
		elseif ch:IsA("Accessory") then
			addAcc(ch)
		elseif ch:IsA("Model") and ch:FindFirstChildOfClass("Humanoid") and not opts.skin then
			ch:Destroy()
		elseif ch:IsA("BasePart") or ch:IsA("Model") or ch:IsA("Folder") or F.isJoint(ch) then
			ch.Parent = container
		elseif F.movable(ch) then
			local rp = F.rigPartFor(rig, "Torso")
			if rp then
				ch.Parent = rp
				track(ch)
			else
				ch:Destroy()
			end
		else
			ch:Destroy()
		end
	end
	cl:Destroy()

	for _, p in ipairs(container:GetDescendants()) do
		if p:IsA("BasePart") then
			F.fixPart(p)
			h.parts = h.parts + 1
		end
	end
	for _, i in ipairs(h.items) do
		if i:IsA("Accessory") then
			for _, p in ipairs(i:GetDescendants()) do
				if p:IsA("BasePart") then
					p.CanCollide = false
					p.Massless = true
					h.parts = h.parts + 1
				end
			end
		end
	end

	-- 4. запасные способы для частей, у которых нет связки с ригом
	if opts.fbCF and not opts.skin then
		for _, top in ipairs(container:GetChildren()) do
			if not connected[top] and not F.isJoint(top) then
				local pp = F.primaryOf(top)
				if pp then
					local done = false
					-- 4a. совпадающие по имени аттачменты (точка крепления есть и у рига, и у предмета)
					for _, a in ipairs(top:GetDescendants()) do
						if a:IsA("Attachment") and a.Parent and a.Parent:IsA("BasePart") then
							local ra = rig:FindFirstChild(a.Name, true)
							if ra and ra:IsA("Attachment") and ra.Parent and ra.Parent:IsA("BasePart") and not F.isOur(ra) then
								local j = Instance.new(JC)
								j.Name = "LocalVisualJoint"
								j.Part0 = ra.Parent
								j.Part1 = a.Parent
								j.C0 = ra.CFrame
								j.C1 = a.CFrame
								j.Parent = ra.Parent
								track(j)
								recordRigJoint(j, true)
								note("крепление по аттачменту " .. a.Name)
								done = true
								break
							end
						end
					end
					-- 4b. смещение относительно пустышки в шаблоне
					if not done then
						local dname, dcf
						for _, nm in ipairs({ "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso" }) do
							if dummyCF[nm] then
								dname, dcf = nm, dummyCF[nm]
								break
							end
						end
						if not dname then
							for nm, cf in pairs(dummyCF) do
								dname, dcf = nm, cf
								break
							end
						end
						local rp = dname and F.rigPartFor(rig, dname)
						if rp and dcf then
							local j = Instance.new(JC)
							j.Name = "LocalVisualJoint"
							j.Part0 = rp
							j.Part1 = pp
							j.C0 = dcf:ToObjectSpace(pp.CFrame)
							j.C1 = CFrame.new()
							j.Parent = rp
							track(j)
							recordRigJoint(j, true)
							note("крепление по смещению от " .. dname)
							done = true
						end
					end
					-- 4c. совсем запасной вариант: к торсу
					if not done then
						local torso = findTorso(rig)
						if torso then
							local j = Instance.new(JC)
							j.Name = "LocalVisualJoint"
							j.Part0 = torso
							j.Part1 = pp
							j.C0 = opts.fbCF
							j.C1 = CFrame.new()
							j.Parent = torso
							track(j)
							if not h.firstJoint then
								h.firstJoint = j
							end
							table.insert(h.rigJoints, { j = j, rigIsP0 = true, c0 = j.C0, c1 = j.C1 })
							note("запасное крепление к торсу (подстрой кнопками)")
						end
					end
				end
			end
		end
	end

	if #container:GetChildren() == 0 and #h.items == 0 then
		F.destroyHandle(h)
		return nil
	end
	return h
end

-- пробует Character / CharacterClassic в нужном порядке, потом остальные способы
function F.graftBest(mod, rig, preferC, name, opts)
	opts = opts or {}
	local c, cc = mod:FindFirstChild("Character"), mod:FindFirstChild("CharacterClassic")
	local a, b = c, cc
	if not preferC then
		a, b = cc, c
	end
	local roots = {}
	if a then
		table.insert(roots, { root = a })
	end
	if b then
		table.insert(roots, { root = b })
	end
	if opts.pickName and mod:FindFirstChild(opts.pickName, true) then
		table.insert(roots, { root = mod, pick = opts.pickName })
	end
	if #roots == 0 and opts.allowSelf then
		table.insert(roots, { root = mod })
	end
	local fallbackH = nil
	for _, r in ipairs(roots) do
		local h = F.graft(r.root, rig, {
			name = name,
			parent = opts.parent,
			skin = opts.skin,
			animated = opts.animated,
			pick = r.pick,
			fbCF = opts.fbCF,
		})
		if h then
			if h.exact > 0 or h.parts == 0 then
				if fallbackH then
					F.destroyHandle(fallbackH)
				end
				return h
			end
			if not fallbackH then
				fallbackH = h
			else
				F.destroyHandle(h)
			end
		end
	end
	return fallbackH
end

-- ручная подстройка реквизита
function F.applyOffset(h, off)
	if not h or not h.rigJoints then
		return
	end
	local o = CFrame.new()
	if off then
		o = CFrame.new(off.x, off.y, off.z) * CFrame.Angles(0, math.rad(off.r), 0)
	end
	for _, rj in ipairs(h.rigJoints) do
		if rj.j and rj.j.Parent then
			if rj.rigIsP0 then
				rj.j.C0 = rj.c0 * o
			else
				rj.j.C1 = rj.c1 * o:Inverse()
			end
		end
	end
end

