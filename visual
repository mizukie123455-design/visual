function F.buildSig()
	sigDirty = false
	sigCache = nil
	if not src then
		return
	end
	local calib = sigDB[src.id]
	local mode, ids = "all", nil
	if calib and #calib > 0 then
		ids = calib
	else
		mode = "any"
		ids = F.moduleIds(src, #rigsNow > 0 and isR15(rigsNow[1]))
	end
	local set, count = {}, 0
	for _, id in ipairs(ids) do
		id = tostring(id)
		if not noise[id] then
			set[id] = true
			count = count + 1
		end
	end
	sigCache = { set = set, count = count, mode = mode, calibrated = (calib ~= nil and #calib > 0) }
end

function F.sigState(act, wmap)
	if sigDirty then
		F.buildSig()
	end
	local S = sigCache
	if not S or S.count == 0 then
		return false, false, 0
	end
	local anyP, allP, mw = false, true, 0
	for id in pairs(S.set) do
		if act[id] then
			anyP = true
		else
			allP = false
		end
		local w = wmap[id]
		if w and w > mw then
			mw = w
		end
	end
	local startOK = (S.mode == "all") and allP or anyP
	return startOK, anyP, mw
end

