local animCache = setmetatable({}, { __mode = "k" })
function F.collectAnims(mod)
	if mod and animCache[mod] then
		return animCache[mod]
	end
	local out = {}
	if not mod then
		return out
	end
	for _, a in ipairs(mod:GetDescendants()) do
		if a:IsA("Animation") and numId(a.AnimationId) then
			local names = relNames(a, mod) or {}
			local p = table.concat(names, "/"):lower()
			if not p:find("intro", 1, true) and not p:find("outro", 1, true) then
				local key
				if p:find("classic", 1, true) then
					key = "classic"
				elseif p:find("r6", 1, true) then
					key = "r6"
				else
					key = "r15"
				end
				if not out[key] then
					out[key] = numId(a.AnimationId)
				end
			end
		end
	end
	animCache[mod] = out
	return out
end

-- список { id =, key = } в порядке приоритета
function F.candidates(entry, r15rig)
	local c = F.collectAnims(entry.mod)
	local order
	if variant == "r6" then
		order = { "r6" }
	elseif variant == "classic" then
		order = { "classic" }
	elseif variant == "r15" then
		order = { "r15" }
	elseif r15rig then
		order = { "r15", "r6", "classic" }
	else
		order = { "r6", "classic", "r15" }
	end
	local out, seen = {}, {}
	for _, k in ipairs(order) do
		local id = c[k]
		if id and not seen[id] then
			seen[id] = true
			table.insert(out, { id = id, key = k })
		end
	end
	if #out == 0 and entry.key == "broom" then
		table.insert(out, {
			id = numId(r15rig and FALLBACK_BROOM.r15 or FALLBACK_BROOM.r6),
			key = r15rig and "r15" or "r6",
		})
	end
	return out
end

function F.moduleIds(entry, r15rig)
	local c = F.collectAnims(entry.mod)
	local ids = {}
	local order = r15rig and { "r15", "r6" } or { "r6", "classic" }
	for _, k in ipairs(order) do
		if c[k] then
			table.insert(ids, c[k])
		end
	end
	if #ids == 0 then
		for _, k in pairs(c) do
			table.insert(ids, k)
		end
	end
	return ids
end

function F.refreshOwn()
	ownIds = {}
	if tgt then
		for _, id in pairs(F.collectAnims(tgt.mod)) do
			ownIds[id] = true
		end
		if tgt.key == "broom" then
			ownIds[numId(FALLBACK_BROOM.r6)] = true
			ownIds[numId(FALLBACK_BROOM.r15)] = true
		end
	end
end

-- звук эмоции: таблица -> Sound внутри модуля -> EmoteInfo.Sound через require
function F.getSound(entry)
	if not entry then
		return nil
	end
	if entry.sound ~= nil then
		return entry.sound or nil
	end
	local info = nil
	local manual = SOUND_IDS[entry.key]
	if manual then
		info = { id = numId(manual) }
	end
	if not info then
		local sObj = entry.mod:FindFirstChild("Sound", true)
		if not (sObj and sObj:IsA("Sound")) then
			sObj = entry.mod:FindFirstChildWhichIsA("Sound", true)
		end
		if sObj and numId(sObj.SoundId) then
			info = { id = numId(sObj.SoundId), looped = sObj.Looped, volume = sObj.Volume }
		end
	end
	if not info and USE_REQUIRE then
		local ok, data = pcall(require, entry.mod)
		if ok and type(data) == "table" and type(data.EmoteInfo) == "table" and data.EmoteInfo.Sound then
			local id = numId(data.EmoteInfo.Sound)
			if id then
				info = { id = id }
			end
		end
	end
	entry.sound = info or false
	return info
end

