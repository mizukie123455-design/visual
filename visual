function F.groupOf(folder)
	local names = {}
	local cur = folder.Parent
	while cur and cur ~= ReplicatedStorage and cur.Name ~= "Items" do
		table.insert(names, 1, cur.Name)
		cur = cur.Parent
	end
	local g = table.concat(names, "/")
	g = (g:gsub("^ItemPacks/", ""))
	if g == "BaseItems" then
		return "магазин"
	end
	if g == "" then
		return "?"
	end
	return g
end

local SKIP_FOLDERS = {
	Nametags = true, Skins = true, Boomboxes = true, Boosters = true,
	Collectables = true, CarryAnimations = true, Perks = true, Loadout = true,
}

function F.addEmote(d)
	if not d:FindFirstChildWhichIsA("Animation", true) then
		return
	end
	local full = d:GetFullName()
	local short = (full:gsub("^ReplicatedStorage%.", ""))
	if byId[short] then
		return
	end
	local e = {
		id = short,
		name = d.Name,
		pretty = prettyName(d.Name),
		key = norm(d.Name),
		mod = d,
		group = F.groupOf(d.Parent),
	}
	table.insert(emotes, e)
	byId[short] = e
end

function F.scanEmotes()
	emotes, byId = {}, {}
	local visited = 0
	local function walk(folder, depth)
		if depth > 8 then
			return
		end
		visited = visited + 1
		if visited % 25 == 0 then
			task.wait()
		end
		for _, c in ipairs(folder:GetChildren()) do
			if c:IsA("Folder") then
				if c.Name == "Emotes" then
					for _, m in ipairs(c:GetChildren()) do
						if m:IsA("ModuleScript") then
							F.addEmote(m)
						end
					end
				elseif c.Name ~= "Cosmetics" and c.Name ~= "CharacterEffects" and not SKIP_FOLDERS[c.Name] then
					walk(c, depth + 1)
				end
			end
		end
	end
	local items = ReplicatedStorage:FindFirstChild("Items")
	walk(items or ReplicatedStorage, 0)
	table.sort(emotes, function(x, y)
		local gx = x.group == "магазин" and 0 or 1
		local gy = y.group == "магазин" and 0 or 1
		if gx ~= gy then
			return gx < gy
		end
		if x.group ~= y.group then
			return x.group < y.group
		end
		return x.name < y.name
	end)
end

function F.findByKey(key, preferShop)
	local best = nil
	for _, e in ipairs(emotes) do
		if e.key == key then
			if not best or (preferShop and e.group == "магазин") then
				best = e
			end
		end
	end
	return best
end

----------------------------------------------------------------------
-- Список косметики / персонажей / эффектов
----------------------------------------------------------------------
local CAT_NAMES = { cosmetic = "Косметика", character = "Персонаж", unusual = "Эффект" }
local FX_CLASSES = { "ParticleEmitter", "Beam", "Trail", "Fire", "Smoke", "Sparkles" }

function F.classify(m, below)
	local low = {}
	for _, n in ipairs(below) do
		table.insert(low, n:lower())
	end
	for _, n in ipairs(low) do
		if n:find("^unusual") or n:find("aura", 1, true) or n:find("effect", 1, true) then
			return "unusual"
		end
	end
	if m.Name:lower():find("aura", 1, true) then
		return "unusual"
	end
	if low[1] == "character" then
		return "character"
	end
	if low[1] == "normal" then
		return "cosmetic"
	end
	-- по содержимому: только частицы без видимых деталей = эффект
	local root = m:FindFirstChild("Character") or m:FindFirstChild("CharacterClassic")
	if root then
		local fx, vis = false, false
		for _, d in ipairs(root:GetDescendants()) do
			for _, cn in ipairs(FX_CLASSES) do
				if d:IsA(cn) then
					fx = true
				end
			end
			if d:IsA("Accessory") or (d:IsA("BasePart") and not BODY[d.Name]) then
				vis = true
			end
		end
		if fx and not vis then
			return "unusual"
		end
	end
	return "cosmetic"
end

function F.scanCosmetics()
	cosItems, cosById = {}, {}
	local items = ReplicatedStorage:FindFirstChild("Items")
	if not items then
		return
	end
	local visited = 0
	local function addCos(m, path, below)
		local cat = F.classify(m, below)
		local hasChar = m:FindFirstChild("Character") or m:FindFirstChild("CharacterClassic")
		local hasFx = false
		if not hasChar and cat == "unusual" then
			hasFx = m:FindFirstChildWhichIsA("ParticleEmitter", true) ~= nil or m:FindFirstChildWhichIsA("BasePart", true) ~= nil
		end
		if not (hasChar or hasFx) then
			return
		end
		local gp = {}
		for _, n in ipairs(path) do
			if n ~= "ItemPacks" and n ~= "BaseItems" then
				table.insert(gp, n)
			end
		end
		local g = table.concat(gp, "/")
		if g == "" then
			g = "база"
		end
		local sub = table.concat(below, "/")
		local short = (m:GetFullName():gsub("^ReplicatedStorage%.", ""))
		local e = {
			id = short,
			name = m.Name,
			pretty = prettyName(m.Name),
			mod = m,
			group = g .. (sub ~= "" and (" / " .. sub) or ""),
			cat = cat,
		}
		e.search = norm(m.Name) .. norm(e.group)
		table.insert(cosItems, e)
		cosById[short] = e
	end
	local function collect(folder, path, below)
		visited = visited + 1
		if visited % 25 == 0 then
			task.wait()
		end
		for _, c in ipairs(folder:GetChildren()) do
			if c:IsA("Folder") then
				local nb = {}
				for _, n in ipairs(below) do
					table.insert(nb, n)
				end
				table.insert(nb, c.Name)
				collect(c, path, nb)
			elseif c:IsA("ModuleScript") then
				addCos(c, path, below)
			end
		end
	end
	local function walk(folder, path, depth)
		if depth > 8 then
			return
		end
		visited = visited + 1
		if visited % 25 == 0 then
			task.wait()
		end
		for _, c in ipairs(folder:GetChildren()) do
			if c:IsA("Folder") then
				if c.Name == "Cosmetics" then
					collect(c, path, {})
				elseif c.Name == "CharacterEffects" then
					collect(c, path, { "CharacterEffects" })
				elseif c.Name ~= "Emotes" and not SKIP_FOLDERS[c.Name] then
					local np = {}
					for _, n in ipairs(path) do
						table.insert(np, n)
					end
					table.insert(np, c.Name)
					walk(c, np, depth + 1)
				end
			end
		end
	end
	walk(items, {}, 0)
	table.sort(cosItems, function(a, b)
		if a.group ~= b.group then
			return a.group < b.group
		end
		return a.name < b.name
	end)
end

