function F.restoreHidden()
	for p in pairs(hiddenCos) do
		pcall(function()
			p.LocalTransparencyModifier = 0
		end)
	end
	hiddenCos = {}
	hideMode = ""
end

function F.clearCos()
	for rig in pairs(cosState) do
		F.clearCosRig(rig)
	end
	F.restoreHidden()
end

function F.wornEntries()
	local out = {}
	if worn.character and cosById[worn.character] then
		table.insert(out, { e = cosById[worn.character], kind = "character" })
	end
	for _, id in ipairs(worn.cosmetic) do
		if cosById[id] then
			table.insert(out, { e = cosById[id], kind = "cosmetic" })
		end
	end
	if worn.unusual and cosById[worn.unusual] then
		table.insert(out, { e = cosById[worn.unusual], kind = "unusual" })
	end
	return out
end

function F.applyCos(e, rig, kind)
	local h = F.graftBest(e.mod, rig, isR15(rig), "LocalCos_" .. e.name, {
		parent = getFolder(),
		skin = (kind == "character"),
		allowSelf = (kind == "unusual"),
		fbCF = CFrame.new(),
	})
	if not h then
		log("не удалось надеть: " .. e.pretty)
	else
		log("надето: " .. e.pretty .. " (креплений " .. h.exact .. ", частей " .. h.parts .. ")")
		for i, n in ipairs(h.notes) do
			if i <= 4 then
				log("  " .. n)
			end
		end
	end
	return h
end

function F.hideOwnStuff(rig, hideAcc, hideBody)
	local mode = (hideAcc and "a" or "") .. (hideBody and "b" or "")
	if mode ~= hideMode then
		F.restoreHidden()
		hideMode = mode
	end
	for _, p in ipairs(rig:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and not hiddenCos[p] then
			if not F.isOur(p) and p.Name ~= "EmoteModel" and not p:FindFirstAncestor("EmoteModel") then
				local isBody = BODY[p.Name] ~= nil
				if (isBody and hideBody) or ((not isBody) and hideAcc) then
					p.LocalTransparencyModifier = 1
					hiddenCos[p] = true
				end
			end
		end
	end
end

function F.cosTick()
	local rigs = F.getRigs()
	local alive = {}
	for _, r in ipairs(rigs) do
		alive[r] = true
	end
	for rig in pairs(cosState) do
		if not alive[rig] or not rig.Parent or not cosOn then
			F.clearCosRig(rig)
		end
	end
	if not cosOn then
		F.restoreHidden()
		return
	end
	local entries = F.wornEntries()
	local parts = {}
	for _, w in ipairs(entries) do
		table.insert(parts, w.kind .. ":" .. w.e.id)
	end
	local sig = table.concat(parts, "|")
	for _, rig in ipairs(rigs) do
		local st = cosState[rig]
		local ok = st ~= nil and st.sig == sig
		if ok then
			for _, h in ipairs(st.handles) do
				if not h.container.Parent or (h.firstJoint and not h.firstJoint.Parent) then
					ok = false
					break
				end
			end
		end
		if not ok then
			F.clearCosRig(rig)
			local handles = {}
			for _, w in ipairs(entries) do
				local okc, h = pcall(F.applyCos, w.e, rig, w.kind)
				if okc and h then
					table.insert(handles, h)
				elseif not okc then
					log("ошибка косметики: " .. tostring(h))
				end
			end
			cosState[rig] = { sig = sig, handles = handles }
		end
		local skin = worn.character ~= nil and cosById[worn.character] ~= nil
		if hideOwn or skin then
			F.hideOwnStuff(rig, hideOwn, skin)
		end
	end
	if not hideOwn and not (worn.character and cosById[worn.character]) then
		F.restoreHidden()
	end
end

