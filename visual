function F.saveData()
	if not writefile then
		return
	end
	local nl = {}
	for id in pairs(noise) do
		table.insert(nl, id)
	end
	pcall(function()
		writefile(SAVE_FILE, HttpService:JSONEncode({
			sig = sigDB,
			noise = nl,
			source = src and src.id or nil,
			target = tgt and tgt.id or nil,
			variant = variant,
			propOff = propOff,
			worn = worn,
			cosOn = cosOn,
			hideOwn = hideOwn,
		}))
	end)
end

function F.loadData()
	for k, l in pairs(BAKED.sig) do
		sigDB[k] = l
	end
	for _, id in ipairs(BAKED.noise) do
		noise[tostring(id)] = true
	end
	if not (isfile and readfile) then
		return nil
	end
	local ok, raw = pcall(function()
		if isfile(SAVE_FILE) then
			return readfile(SAVE_FILE)
		end
		return nil
	end)
	if not ok or not raw then
		return nil
	end
	local ok2, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok2 or type(data) ~= "table" then
		return nil
	end
	if type(data.sig) == "table" then
		for k, l in pairs(data.sig) do
			sigDB[k] = l
		end
	end
	if type(data.noise) == "table" then
		for _, id in ipairs(data.noise) do
			noise[tostring(id)] = true
		end
	end
	if type(data.propOff) == "table" then
		for k, o in pairs(data.propOff) do
			if type(o) == "table" then
				propOff[k] = { x = tonumber(o.x) or 0, y = tonumber(o.y) or 0, z = tonumber(o.z) or 0, r = tonumber(o.r) or 0 }
			end
		end
	end
	return data
end

