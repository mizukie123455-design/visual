function F.cleanup()
	enabled = false
	force = false
	cosOn = false
	learn = nil
	pcall(function()
		RunService:UnbindFromRenderStep("EmoteSwapStep")
	end)
	if charConn then
		charConn:Disconnect()
	end
	F.stopVisual()
	pcall(F.clearCos)
	local folder = workspace:FindFirstChild("LocalBroomFolder")
	if folder then
		folder:Destroy()
	end
	if gui then
		gui:Destroy()
	end
end

