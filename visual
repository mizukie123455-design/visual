function F.restoreSound()
	duckReady = false
	for _, c in ipairs(duckConns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	duckConns = {}
	for s, vol in pairs(ducked) do
		pcall(function()
			if s and s.Parent then
				s.Volume = vol
			end
		end)
	end
	ducked = {}
	if localSound then
		pcall(function()
			localSound:Stop()
			localSound:Destroy()
		end)
		localSound = nil
	end
end

function F.duckSound(d)
	local si = F.getSound(src)
	if not duckReady or not si then
		return
	end
	if d:IsA("Sound") and numId(d.SoundId) == si.id then
		if ducked[d] == nil then
			ducked[d] = d.Volume
			table.insert(duckConns, d:GetPropertyChangedSignal("Volume"):Connect(function()
				if duckReady and soundOn and d.Volume ~= 0 then
					d.Volume = 0
				end
			end))
		end
		d.Volume = 0
	end
end

function F.startDucking()
	if not soundOn or not F.getSound(src) then
		return
	end
	duckReady = true
	local roots = { SoundService }
	if LocalPlayer.Character then
		table.insert(roots, LocalPlayer.Character)
	end
	for _, r in ipairs(rigsNow) do
		table.insert(roots, r)
	end
	local rigsFolder = workspace:FindFirstChild("Rigs")
	if rigsFolder then
		table.insert(roots, rigsFolder)
	end
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		table.insert(roots, pg)
	end
	for _, root in ipairs(roots) do
		table.insert(duckConns, root.DescendantAdded:Connect(function(d)
			pcall(F.duckSound, d)
		end))
	end
	task.spawn(function()
		local n = 0
		for _, root in ipairs(roots) do
			for _, d in ipairs(root:GetDescendants()) do
				if not duckReady then
					return
				end
				pcall(F.duckSound, d)
				n = n + 1
				if n % 300 == 0 then
					task.wait()
				end
			end
		end
	end)
end

function F.playLocalSound(part)
	local si = F.getSound(tgt)
	if not soundOn or not si or not part then
		return
	end
	if localSound and localSound.Parent then
		if not localSound.IsPlaying then
			localSound:Play()
		end
		return
	end
	local s = Instance.new("Sound")
	s.Name = "LocalSwapAudio"
	s.SoundId = asset(si.id)
	localBase = (si.volume and si.volume > 0) and si.volume or 1
	s.Volume = localBase
	s.Looped = (si.looped == nil) and true or si.looped
	s.Parent = part
	s:Play()
	localSound = s
end

