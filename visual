local function norm(s)
	return (tostring(s or ""):lower():gsub("[^%w]", ""))
end

local function numId(s)
	return tostring(s or ""):match("(%d+)")
end

local function asset(id)
	local n = numId(id)
	if not n or n == "" then
		return tostring(id or "")
	end
	return "rbxassetid://" .. n
end

local function prettyName(n)
	return (tostring(n):gsub("(%l)(%u)", "%1 %2"))
end

local function isR15(model)
	local hum = model and model:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.RigType == Enum.HumanoidRigType.R15
end

local function relNames(inst, ancestor)
	local names = {}
	local cur = inst
	while cur and cur ~= ancestor do
		table.insert(names, 1, cur.Name)
		cur = cur.Parent
	end
	if cur ~= ancestor then
		return nil
	end
	return names
end

local function getFolder()
	local folder = workspace:FindFirstChild("LocalBroomFolder")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "LocalBroomFolder"
		folder.Parent = workspace
	end
	return folder
end

local function findRoot(model)
	if not model then
		return nil
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	for _, n in ipairs({ "HumanoidRootPart", "TorsoRot", "Torso" }) do
		local p = model:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return nil
end

local function findTorso(model)
	for _, n in ipairs({ "Torso", "UpperTorso", "LowerTorso" }) do
		local p = model:FindFirstChild(n, true)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return findRoot(model)
end

local function indexOf(t, v)
	for i, x in ipairs(t) do
		if x == v then
			return i
		end
	end
	return nil
end

