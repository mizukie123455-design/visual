-- act[id] = ранг приоритета активных треков, wmap[id] = текущий вес
function F.sample()
	local act, wmap = {}, {}
	for _, a in ipairs(animList) do
		if a.Parent then
			for _, t in ipairs(a:GetPlayingAnimationTracks()) do
				local anim = t.Animation
				local n = anim and numId(anim.AnimationId)
				if n then
					local w = t.WeightCurrent
					if (wmap[n] or -1) < w then
						wmap[n] = w
					end
					if t.WeightTarget > 0.02 then
						local rk = RANK[t.Priority.Name] or 0
						if (act[n] or -1) < rk then
							act[n] = rk
						end
					end
				end
			end
		end
	end
	return act, wmap
end

