	if not ok then
		log("дамп не удался: " .. tostring(text))
		return
	end
	local copied = pcall(function()
		setclipboard(text)
	end)
	log("дамп структуры " .. tgt.pretty .. ": " .. tostring(n) .. " строк" .. (copied and ", скопирован в буфер" or ""))
	local c = 0
	for line in text:gmatch("[^\n]+") do
		c = c + 1
		if c > 40 then
			break
		end
		log(line)
	end
end)

