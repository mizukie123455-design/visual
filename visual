-- дамп структуры эмоции (для отладки)
function F.dumpModule(mod)
	local lines = {}
	local function add(s)
		if #lines < 500 then
			table.insert(lines, s)
		end
	end
	local function walk(inst, depth)
		if depth > 7 then
			return
		end
		for _, c in ipairs(inst:GetChildren()) do
			local extra = ""
			if c:IsA("JointInstance") then
				extra = " [" .. tostring(c.Part0 and c.Part0:GetFullName() or "nil") .. " -> " .. tostring(c.Part1 and c.Part1.Name or "nil") .. "]"
			elseif c:IsA("WeldConstraint") then
				extra = " [" .. tostring(c.Part0 and c.Part0.Name or "nil") .. " -> " .. tostring(c.Part1 and c.Part1.Name or "nil") .. "]"
			elseif c:IsA("Animation") then
				extra = " " .. tostring(c.AnimationId)
			elseif c:IsA("Sound") then
				extra = " " .. tostring(c.SoundId)
			elseif c:IsA("BasePart") then
				extra = " size=" .. tostring(c.Size)
			elseif c:IsA("Attachment") then
				extra = " cf=" .. tostring(c.Position)
			end
			add(string.rep("  ", depth) .. c.Name .. " (" .. c.ClassName .. ")" .. extra)
			walk(c, depth + 1)
		end
	end
	add(mod:GetFullName())
	walk(mod, 1)
	if USE_REQUIRE then
		local ok, data = pcall(require, mod)
		if ok and type(data) == "table" then
			add("require ->")
			for k, v in pairs(data) do
				add("  " .. tostring(k) .. " = " .. (type(v) == "table" and "{table}" or tostring(v)))
				if type(v) == "table" then
					for k2, v2 in pairs(v) do
						add("    " .. tostring(k2) .. " = " .. (type(v2) == "table" and "{table}" or tostring(v2)))
					end
				end
			end
		else
			add("require: " .. tostring(data))
		end
	end
	return table.concat(lines, "\n"), #lines
end

