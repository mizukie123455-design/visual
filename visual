function F.startLearn(kind)
	if learn then
		learn = nil
		F.paintLearn()
		setStatus("Отменено.", false)
		return
	end
	if kind == "sig" and not src then
		setStatus("Сначала выбери эмоцию, которую нажимаешь.", false)
		return
	end
	F.stopVisual()
	F.refreshAnimators()
	local act = F.sample()
	local base = {}
	for id, rk in pairs(act) do
		if rk >= RANK_ACTION then
			base[id] = true
		end
	end
	learn = { kind = kind, t0 = os.clock(), base = base, seen = {}, dur = 8 }
	F.paintLearn()
	if kind == "noise" then
		log("запись шума 8 сек: жми Ctrl, прыгай, включай ДРУГИЕ эмоции (не нужную)")
	else
		log("жду, когда ты нажмёшь \"" .. src.pretty .. "\" (стой на месте 4 сек)")
	end
end

function F.learnSnapshot(act, L)
	local s = {}
	for id, rk in pairs(act) do
		if rk >= RANK_ACTION and not L.base[id] and not noise[id] and not ownIds[id] then
			s[id] = true
		end
	end
	return s
end

function F.handleLearn(now)
	local L = learn
	local act = F.sample()
	if L.kind == "noise" then
		for id, rk in pairs(act) do
			if rk >= RANK_ACTION and not L.base[id] and not ownIds[id] then
				L.seen[id] = true
			end
		end
		local left = L.t0 + L.dur - now
		if left > 0 then
			setStatus("Шум: ещё " .. math.ceil(left) .. " сек. Ctrl, прыжки, другие эмоции.", true)
			return
		end
		local l = {}
		for id in pairs(L.seen) do
			noise[id] = true
			table.insert(l, id)
		end
		table.sort(l)
		learn = nil
		F.paintLearn()
		sigDirty = true
		F.saveData()
		log("шум записан: " .. (#l > 0 and table.concat(l, ", ") or "ничего нового"))
		setStatus("Шум записан. Теперь \"2. Запомнить id\".", true)
		return
	end

	if not L.trigger then
		for id, rk in pairs(act) do
			if rk >= RANK_ACTION and not L.base[id] and not noise[id] and not ownIds[id] then
				L.trigger = now
				break
			end
		end
		if not L.trigger then
			if now - L.t0 > 25 then
				learn = nil
				F.paintLearn()
				log("не увидела эмоцию за 25 сек. Попробуй ещё раз")
				setStatus("Не увидела эмоцию.", false)
			else
				setStatus("Нажми \"" .. src.pretty .. "\" в колесе и стой на месте.", true)
			end
		end
		return
	end

	local dt = now - L.trigger
	if dt >= 1.5 and not L.s1 then
		L.s1 = F.learnSnapshot(act, L)
	end
	if dt >= 3.0 and L.s1 then
		local s2 = F.learnSnapshot(act, L)
		local res = {}
		for id in pairs(L.s1) do
			if s2[id] then
				table.insert(res, id)
			end
		end
		table.sort(res)
		learn = nil
		F.paintLearn()
		if #res == 0 then
			log("не получилось: нет устойчивых id. Стой на месте и держи эмоцию 4 сек")
			setStatus("Не получилось. Попробуй ещё раз.", false)
		else
			sigDB[src.id] = res
			sigDirty = true
			F.saveData()
			F.updateButtons()
			log("запомнила для " .. src.pretty .. ": " .. table.concat(res, ", "))
			setStatus("id запомнены. Можно включать подмену.", true)
		end
	elseif dt > 10 then
		learn = nil
		F.paintLearn()
		log("эмоция закончилась слишком быстро")
		setStatus("Не получилось. Держи эмоцию 4 сек.", false)
	end
end

----------------------------------------------------------------------
-- Главный цикл
----------------------------------------------------------------------
function F.onStep()
	local now = os.clock()

	if now - lastCos > 0.5 then
		lastCos = now
		local ok, err = pcall(F.cosTick)
		if not ok and tostring(err) ~= lastErr then
			lastErr = tostring(err)
			log("ошибка косметики: " .. lastErr)
		end
	end

	if now - lastRefresh > 1.0 and not showing then
		lastRefresh = now
		pcall(F.refreshAnimators)
		if enabled and not building and not learn then
			task.spawn(function()
				pcall(F.prewarm)
			end)
		end
	end

	if learn then
		pcall(F.handleLearn, now)
		return
	end

	if not enabled then
		if showing then
			F.stopVisual()
		end
		return
	end

	local act, wmap = F.sample()
	local startOK, holdOK, mw
	if force then
		startOK, holdOK, mw = true, true, 1
	else
		startOK, holdOK, mw = F.sigState(act, wmap)
	end

	if not showing then
		if startOK and not building and now >= nextTry then
			building = true
			task.spawn(function()
				local ok, res = pcall(F.startVisual)
				if not ok then
					log("ошибка: " .. tostring(res))
					nextTry = os.clock() + 2
				elseif not res then
					nextTry = os.clock() + 2
				end
				building = false
			end)
		end
		return
	end

	if not showSince then
		showSince = now
	end
	local holding = holdOK or mw > 0.03
	for _, v in ipairs(visuals) do
		if not v.rig.Parent then
			holding = false
		end
	end
	if not holding then
		F.stopVisual()
		setStatus("Включено. Жду \"" .. (src and src.pretty or "эмоцию") .. "\".", true)
		return
	end

	-- сторож реквизита и скрытие реквизита исходной эмоции
	if now - lastProp > 0.4 then
		lastProp = now
		for _, v in ipairs(visuals) do
			local p = v.prop
			local broken = hasProp and tgt ~= nil
				and ((not p) or (not p.container.Parent) or (p.firstJoint ~= nil and not p.firstJoint.Parent))
			if broken then
				if p then
					F.destroyHandle(p)
				end
				propFails = propFails + 1
				if propFails >= 4 and not propInFolder then
					propInFolder = true
					log("игра удаляет реквизит из рига, переношу его в отдельную папку")
				end
				v.prop = F.attachProp(tgt, v.rig, v.key, true)
			end
			local em = v.rig:FindFirstChild("EmoteModel")
			if em then
				F.hideGameProp(em)
			end
		end
	end

	-- вес подмены: в начале полный, потом повторяет вес исходной эмоции
	local bw
	if force or (showSince and now - showSince < 0.6) then
		bw = 1
	elseif mw > 0.03 then
		bw = math.clamp(mw * 1.5, 0, 1)
	else
		bw = holdOK and 1 or 0
	end
	for _, v in ipairs(visuals) do
		if holdOK and not v.track.IsPlaying then
			pcall(function()
				v.track.Looped = true
				v.track:Play(0, 1, 1)
			end)
		end
		pcall(function()
			v.track:AdjustWeight(bw, 0)
		end)
	end

	if soundOn then
		if not duckReady then
			F.startDucking()
		end
		local root = visuals[1] and findRoot(visuals[1].rig)
		F.playLocalSound(root)
		if localSound then
			pcall(function()
				localSound.Volume = localBase * bw
			end)
		end
	else
		F.restoreSound()
	end
end

