function F.attachProp(e, rig, key, silent)
	if not e or not rig then
		return nil
	end
	local preferC
	if key == "r15" then
		preferC = true
	elseif key then
		preferC = false
	else
		preferC = isR15(rig)
	end
	local h = F.graftBest(e.mod, rig, preferC, "LocalEmoteProp", {
		parent = propInFolder and getFolder() or rig,
		pickName = "EmoteModel",
		animated = true,
		fbCF = CFrame.new(0, 0, -1.2),
	})
	if h then
		F.applyOffset(h, propOff[e.id])
		if not silent then
			log("реквизит: креплений " .. h.exact .. ", частей " .. h.parts)
			for _, n in ipairs(h.notes) do
				log("  " .. n)
			end
		end
	elseif not silent then
		log("реквизита у этой эмоции нет (или не найден). Нажми \"Дамп\", если он должен быть")
	end
	return h
end

