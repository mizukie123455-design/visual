function F.makeTrack(animator, id)
	local anim = Instance.new("Animation")
	anim.AnimationId = asset(id)
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if not ok or not track then
		log("LoadAnimation: " .. tostring(track))
		return nil
	end
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = true
	anim.Parent = animator.Parent
	return track
end

function F.prewarm()
	if not tgt or building or showing then
		return
	end
	for _, a in ipairs(animList) do
		if a.Parent then
			local rig = a:FindFirstAncestorOfClass("Model")
			local c = F.candidates(tgt, rig and isR15(rig))
			local id = c[1] and c[1].id
			local p = pre[a]
			if id and not (p and p.id == id and p.track) then
				local tr = F.makeTrack(a, id)
				if tr then
					pre[a] = { id = id, track = tr }
				end
			end
		end
	end
end

function F.loadWorking(animator, cands, token)
	for _, cand in ipairs(cands) do
		local id = cand.id
		local p = pre[animator]
		local track
		local isPre = false
		if p and p.id == id and p.track and p.track.Length > 0 then
			track = p.track
			isPre = true
		else
			track = F.makeTrack(animator, id)
		end
		if track then
			local t0 = os.clock()
			while track.Length <= 0 and os.clock() - t0 < 1.5 and not token.dead do
				task.wait(0.1)
			end
			if track.Length > 0 then
				return track, id, cand.key
			end
			log("анимация " .. tostring(id) .. " не загрузилась")
			if not isPre then
				pcall(function()
					track:Destroy()
				end)
			end
		end
	end
	return nil, nil, nil
end

function F.stopVisual()
	if visualToken then
		visualToken.dead = true
		visualToken = nil
	end
	for _, v in ipairs(visuals) do
		pcall(function()
			v.track:Stop(0.1)
			local p = pre[v.animator]
			if not (p and p.track == v.track) then
				v.track:Destroy()
			end
		end)
		if v.prop then
			F.destroyHandle(v.prop)
		end
	end
	visuals = {}
	for p in pairs(hiddenProps) do
		pcall(function()
			p.LocalTransparencyModifier = 0
		end)
	end
	hiddenProps = {}
	F.restoreSound()
	showing = false
	showSince = nil
end

function F.startVisual()
	if not tgt then
		return false
	end
	if #rigsNow == 0 then
		log("не нашла твой риг в Workspace.Rigs")
		return false
	end
	local token = { dead = false }
	visualToken = token
	local result = {}
	local usedCand = nil
	for _, rig in ipairs(rigsNow) do
		local animator = rig:FindFirstChildWhichIsA("Animator", true)
		if animator then
			local cands = F.candidates(tgt, isR15(rig))
			if usedCand then
				table.insert(cands, 1, usedCand)
			end
			local track, id, key = F.loadWorking(animator, cands, token)
			if token.dead then
				return false
			end
			if track then
				usedCand = usedCand or { id = id, key = key }
				table.insert(result, { rig = rig, animator = animator, track = track, id = id, key = key })
			end
		end
	end
	if token.dead or not enabled then
		for _, v in ipairs(result) do
			pcall(function()
				v.track:Stop(0)
			end)
		end
		return false
	end
	if #result == 0 then
		log("анимация цели не загрузилась. Попробуй кнопку \"Анимация\" (R6/Classic/R15)")
		visualToken = nil
		return false
	end
	local first = true
	for _, v in ipairs(result) do
		v.track.Looped = true
		v.track:Play(0, 1, 1)
		v.track:AdjustWeight(1, 0)
		v.prop = F.attachProp(tgt, v.rig, v.key, not first)
		if v.prop then
			hasProp = true
		elseif first then
			hasProp = false
		end
		first = false
	end
	visuals = result
	showing = true
	log("подмена включена: " .. tgt.pretty .. " (ригов: " .. #result .. ", анимация " .. tostring(usedCand and usedCand.id) .. ")")
	return true
end

